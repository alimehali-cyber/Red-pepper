    <!-- Prediction micro-prompts -->
    <string name="zig_gravity_pred_mass_opt_change">مدار عوض می‌شود</string>
    <string name="zig_gravity_pred_mass_opt_none">تقریباً هیچ</string>
    <string name="zig_gravity_pred_mass_reaction">جرم بیشتر، جاذبهٔ بیشتر — ولی اینرسی هم بیشتر؛ مدارِ خودِ جسم تقریباً بی‌تفاوت! فقط لرزش جسمِ دیگر بزرگتر می‌شود.</string>
    <string name="zig_gravity_pred_vel_opt_expand">مدار بزرگتر می‌شود</string>
    <string name="zig_gravity_pred_vel_opt_fall">می‌افتد پایین</string>
    <string name="zig_gravity_pred_vel_reaction">سرعت بیشتر، مدار بزرگتر — و اگر از سرعت گریز بگذرد، دیگر هیچ مداری نیست.</string>
    <string name="zig_gravity_pred_size_reaction">اندازه در این آزمایش قراردادِ نمایش است و شعاعِ برخورد را عوض می‌کند — نه فیزیکِ گرانش را.</string>

    <!-- Challenge 1 -->
    <string name="zig_gravity_challenge_1_title">جرم دوبرابر</string>
    <string name="zig_gravity_challenge_1_intro">اگر جرم زمین را دو برابر کنیم، مدارش به دور خورشید چه تغییری می‌کند؟</string>
    <string name="zig_gravity_challenge_1_opt_1">مدار زمین تندتر و تنگ‌تر می‌شود</string>
    <string name="zig_gravity_challenge_1_opt_2">مدار زمین تقریباً بدون تغییر می‌ماند</string>
    <string name="zig_gravity_challenge_1_opt_3">زمین می‌گیرد و داخل خورشید می‌افتد</string>
    <string name="zig_gravity_challenge_1_success">گرانش دو برابر، اینرسی دو برابر — این دو اثر دقیقاً یکدیگر را خنثی می‌کنند! تنها تغییر واقعی: لرزش خورشید دو برابر بزرگتر می‌شود.</string>

    <!-- Challenge 2 -->
    <string name="zig_gravity_challenge_2_title">زمینِ دورتر</string>
    <string name="zig_gravity_challenge_2_intro">اگر سیاره‌ای در فاصلهٔ ۱٫۵ برابر زمین قرار گیرد، طول سال آن چه تغییری می‌کند؟</string>
    <string name="zig_gravity_challenge_2_opt_1">سالِ کوتاه‌تر و حرکت تندتر</string>
    <string name="zig_gravity_challenge_2_opt_2">سالِ بلندتر و حرکت کندتر</string>
    <string name="zig_gravity_challenge_2_opt_3">بدون تغییر</string>
    <string name="zig_gravity_challenge_2_success">کپلر: در ۱٫۵ برابر فاصله، سال حدود ۱٫۸ برابر بلندتر می‌شود (T² ∝ a³).</string>

    <!-- Challenge 3 -->
    <string name="zig_gravity_challenge_3_title">سرعتِ زیاد</string>
    <string name="zig_gravity_challenge_3_intro">اگر تیله‌ای در مدار زمین با سرعت ۴۵ کیلومتر بر ثانیه پرتاب شود، چه رخ می‌دهد؟</string>
    <string name="zig_gravity_challenge_3_opt_1">مدار پایین‌تر می‌شود</string>
    <string name="zig_gravity_challenge_3_opt_2">تندتر می‌چرخد ولی می‌ماند</string>
    <string name="zig_gravity_challenge_3_opt_3">از چنگ گرانش می‌رود</string>
    <string name="zig_gravity_challenge_3_success">۴۵ کیلومتر بر ثانیه از سرعت گریزِ ۴۲٫۱ گذشته — دیگر هیچ مداری نگهش نمی‌دارد.</string>

    <!-- Challenge 4 -->
    <string name="zig_gravity_challenge_4_title">رقص دو ستاره</string>
    <string name="zig_gravity_challenge_4_intro">در سامانهٔ دو ستاره با جرم برابر، حرکت آن‌ها چگونه است؟</string>
    <string name="zig_gravity_challenge_4_opt_1">ستارهٔ بزرگتر، کوچکتر را می‌چرخاند</string>
    <string name="zig_gravity_challenge_4_opt_2">هر دو گردِ نقطهٔ نامرئی وسط می‌چرخند</string>
    <string name="zig_gravity_challenge_4_opt_3">هر دو ساکن‌اند</string>
    <string name="zig_gravity_challenge_4_success">به لرزش ظریف هر دو دقت کن — مرکز جرم جایی است که هیچ‌چیز نیست!</string>

    <!-- Challenge 5 -->
    <string name="zig_gravity_challenge_5_title">برخورد دو سیاره</string>
    <string name="zig_gravity_challenge_5_intro">وقتی دو سیاره با جرم و سرعت برابر روبروی هم برخورد کنند، چه رخ می‌دهد؟</string>
    <string name="zig_gravity_challenge_5_opt_1">با شتاب به بیرون می‌جهند</string>
    <string name="zig_gravity_challenge_5_opt_2">یکی می‌ایستد و یکی می‌رود</string>
    <string name="zig_gravity_challenge_5_opt_3">تقریباً ساکن، یکی می‌شوند</string>
    <string name="zig_gravity_challenge_5_success">تکانه‌ها تقریباً یکدیگر را خنثی می‌کنند؛ جسمِ تازه تقریباً ساکن است. پایستگی تکانه، عیناً!</string>

    <!-- Challenge 6 -->
    <string name="zig_gravity_challenge_6_title">شکار سیاهچاله</string>
    <string name="zig_gravity_challenge_6_intro">اگر تیله‌ای مستقیماً به سمت سیاهچاله حرکت کند، چه بر سر آن می‌آید؟</string>
    <string name="zig_gravity_challenge_6_opt_1">از کنارش رد می‌شود و ادامه می‌دهد</string>
    <string name="zig_gravity_challenge_6_opt_2">مثل توپ برمی‌گردد</string>
    <string name="zig_gravity_challenge_6_opt_3">برای همیشه اسیر می‌شود</string>
    <string name="zig_gravity_challenge_6_success">از لبهٔ افق رویداد به بعد، هر مسیری به داخل ختم می‌شود.</string>

    <!-- Challenge 7 -->
    <string name="zig_gravity_challenge_7_title">سفر کرمچاله</string>
    <string name="zig_gravity_challenge_7_intro">تیله‌ای با سرعت ۳۰ کیلومتر بر ثانیه وارد دهانهٔ کرمچاله می‌شود. خروج آن چگونه است؟</string>
    <string name="zig_gravity_challenge_7_opt_1">دروازه او را نگه می‌دارد</string>
    <string name="zig_gravity_challenge_7_opt_2">با همان سرعت از دروازهٔ دیگر بیرون می‌آید</string>
    <string name="zig_gravity_challenge_7_opt_3">نابود می‌شود</string>
    <string name="zig_gravity_challenge_7_success">همان سرعت، همان جهت — فقط «اینجا» عوض شد. و یادت باشد: فرضی!</string>

    <!-- Challenge 8 -->
    <string name="zig_gravity_challenge_8_title">ماه چرا نمی‌افتد؟</string>
    <string name="zig_gravity_challenge_8_intro">چرا ماه با وجود گرانش زمین، روی آن سقوط نمی‌کند؟</string>
    <string name="zig_gravity_challenge_8_opt_1">در فضا گرانش نیست</string>
    <string name="zig_gravity_challenge_8_opt_2">با نیرویی مقابل در تعادل است</string>
    <string name="zig_gravity_challenge_8_opt_3">دائماً می‌افتد، ولی به پهلو هم می‌رود</string>
    <string name="zig_gravity_challenge_8_success">نیوتن: ماه دقیقاً مثل سیب می‌افتد — فقط زمین را «خطا می‌زند». سقوطِ دائمی، یعنی مدار.</string>
</resources>
