    <!-- Prediction micro-prompts -->
    <string name="zig_gravity_pred_mass_opt_change">The orbit changes</string>
    <string name="zig_gravity_pred_mass_opt_none">Almost nothing</string>
    <string name="zig_gravity_pred_mass_reaction">More mass, more gravity — but also more inertia; the body\'s own orbit barely changes! Only the other body wobbles more.</string>
    <string name="zig_gravity_pred_vel_opt_expand">The orbit expands</string>
    <string name="zig_gravity_pred_vel_opt_fall">It falls inward</string>
    <string name="zig_gravity_pred_vel_reaction">Higher speed, bigger orbit — and past escape velocity, no orbit remains at all.</string>
    <string name="zig_gravity_pred_size_reaction">Size here is a display convention that sets collision radius — not the physics of gravity.</string>

    <!-- Challenge 1 -->
    <string name="zig_gravity_challenge_1_title">Double the mass</string>
    <string name="zig_gravity_challenge_1_intro">If we double Earth\'s mass, what happens to its orbit around the Sun?</string>
    <string name="zig_gravity_challenge_1_opt_1">Earth\'s orbit becomes faster and tighter</string>
    <string name="zig_gravity_challenge_1_opt_2">Earth\'s orbit remains almost unchanged</string>
    <string name="zig_gravity_challenge_1_opt_3">Earth falls into the Sun</string>
    <string name="zig_gravity_challenge_1_success">Double gravity, double inertia — they cancel each other out! The only real change: the Sun wobbles twice as much.</string>

    <!-- Challenge 2 -->
    <string name="zig_gravity_challenge_2_title">Distant Earth</string>
    <string name="zig_gravity_challenge_2_intro">If a planet is placed at 1.5 times Earth\'s distance, how does its year change?</string>
    <string name="zig_gravity_challenge_2_opt_1">Shorter year and faster motion</string>
    <string name="zig_gravity_challenge_2_opt_2">Longer year and slower motion</string>
    <string name="zig_gravity_challenge_2_opt_3">No change</string>
    <string name="zig_gravity_challenge_2_success">Kepler: at 1.5× distance, the year is about 1.8× longer (T² ∝ a³).</string>

    <!-- Challenge 3 -->
    <string name="zig_gravity_challenge_3_title">Too fast</string>
    <string name="zig_gravity_challenge_3_intro">If a test marble at 1 AU is launched at 45 km/s, what happens?</string>
    <string name="zig_gravity_challenge_3_opt_1">The orbit lowers</string>
    <string name="zig_gravity_challenge_3_opt_2">Orbits faster but stays bound</string>
    <string name="zig_gravity_challenge_3_opt_3">Escapes gravity\'s grip</string>
    <string name="zig_gravity_challenge_3_success">45 km/s exceeds the escape velocity of 42.1 km/s — no orbit can hold it.</string>

    <!-- Challenge 4 -->
    <string name="zig_gravity_challenge_4_title">Two-star dance</string>
    <string name="zig_gravity_challenge_4_intro">In a binary system with equal masses, how do the stars move?</string>
    <string name="zig_gravity_challenge_4_opt_1">The larger star orbits the smaller one</string>
    <string name="zig_gravity_challenge_4_opt_2">Both orbit the invisible midpoint</string>
    <string name="zig_gravity_challenge_4_opt_3">Both remain stationary</string>
    <string name="zig_gravity_challenge_4_success">Notice their synchronized motion — the center of mass is empty space!</string>

    <!-- Challenge 5 -->
    <string name="zig_gravity_challenge_5_title">Planetary collision</string>
    <string name="zig_gravity_challenge_5_intro">When two identical planets collide head-on, what happens?</string>
    <string name="zig_gravity_challenge_5_opt_1">They bounce outward rapidly</string>
    <string name="zig_gravity_challenge_5_opt_2">One stops and one continues</string>
    <string name="zig_gravity_challenge_5_opt_3">They merge almost at rest</string>
    <string name="zig_gravity_challenge_5_success">Momenta cancel out; the new merged body is nearly stationary. Pure conservation of momentum!</string>

    <!-- Challenge 6 -->
    <string name="zig_gravity_challenge_6_title">Captured</string>
    <string name="zig_gravity_challenge_6_intro">If a marble heads directly toward a black hole, what happens?</string>
    <string name="zig_gravity_challenge_6_opt_1">Passes by and continues</string>
    <string name="zig_gravity_challenge_6_opt_2">Bounces back like a ball</string>
    <string name="zig_gravity_challenge_6_opt_3">Captured forever</string>
    <string name="zig_gravity_challenge_6_success">Beyond the event horizon, all paths lead inward.</string>

    <!-- Challenge 7 -->
    <string name="zig_gravity_challenge_7_title">Wormhole trip</string>
    <string name="zig_gravity_challenge_7_intro">A marble enters a wormhole mouth at 30 km/s. How does it exit?</string>
    <string name="zig_gravity_challenge_7_opt_1">The gate holds it</string>
    <string name="zig_gravity_challenge_7_opt_2">Exits the other gate at the same speed</string>
    <string name="zig_gravity_challenge_7_opt_3">It is destroyed</string>
    <string name="zig_gravity_challenge_7_success">Same speed, same direction — only location changed. And remember: hypothetical!</string>

    <!-- Challenge 8 -->
    <string name="zig_gravity_challenge_8_title">Why doesn\'t the Moon fall?</string>
    <string name="zig_gravity_challenge_8_intro">Why doesn\'t the Moon crash into Earth despite Earth\'s gravity?</string>
    <string name="zig_gravity_challenge_8_opt_1">There is no gravity in space</string>
    <string name="zig_gravity_challenge_8_opt_2">Balanced by an opposing force</string>
    <string name="zig_gravity_challenge_8_opt_3">It falls constantly, but also moves sideways</string>
    <string name="zig_gravity_challenge_8_success">Newton: the Moon falls just like an apple — it just keeps \'missing\' Earth. Perpetual fall is an orbit.</string>
</resources>
